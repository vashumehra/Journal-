<style>
    :root {
        --primary-color: #1b224f; /* Navy Blue */
        --accent-gold: #C5A059;                                   /* Logo Accent Gold */
        --gold-light: #F4E8C1;                                    /* Soft Gold Hover Background */
        --dark-blue: #0f142d;     /* Dark Navy Text */
        --light-bg: #f9fafc;         /* Off-White Light Background */
        --transition: all 0.3s ease-in-out;
    }

    body {
        font-family: 'serif', sans-serif;
        background-color: var(--light-bg);
    }

    h1, h2, h3, .fw-bold, .nav-link {
        font-family: 'Poppins', sans-serif;
    }

    /* Top Bar Styling */
    .top-bar {
        background: var(--light-bg);
        font-size: 13px;
        padding: 8px 0;
        color: var(--dark-blue);
    }

    /* Main Navbar */
    .navbar {
        transition: var(--transition);
        padding: 15px 0;
        background: #fff;
    }

    .navbar-brand .journal-title {
        color: var(--primary-color);
        font-size: 1.4rem;
        transition: var(--transition);
    }

    /* Nav Links */
    .nav-link {
        color: var(--dark-blue);
        font-weight: 500;
        font-size: 14px;
        position: relative;
        padding: 10px 15px !important;
        transition: var(--transition);
    }

    .nav-link::before {
        content: "";
        position: absolute;
        width: 0;
        height: 2px;
        bottom: 0;
        left: 15px;
        background-color: var(--accent-gold);
        transition: var(--transition);
    }

    .nav-link:hover::before,
    .nav-link.active::before {
        width: calc(100% - 30px);
    }

    .nav-link:hover, 
    .navbar-nav .nav-link.active,
    .navbar-nav .nav-link.show {
        color: var(--accent-gold) !important;
    }

    /* Search Bar & Button Styling */
    .search-container .input-group {
        border-radius: 5px;
        overflow: hidden;
        border: 1px solid var(--light-bg);
    }

    .btn-submit {
        background: var(--accent-gold);
        color: var(--primary-color);
        border-radius: 4px;
        padding: 8px 25px;
        border: none;
        transition: var(--transition);
        font-weight: 600;
    }

    .btn-submit:hover {
        background: var(--primary-color);
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(27, 34, 79, 0.2);
    }

    /* Dropdown Menu */
    .dropdown-menu {
        border: none;
        border-radius: 4px;
        box-shadow: 0px 5px 30px rgba(27, 34, 79, 0.15);
        border-top: 3px solid var(--accent-gold);
        padding: 10px 0;
        animation: fadeIn 0.3s ease-in;
    }

    .dropdown-item {
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: var(--dark-blue) !important;
        padding: 10px 20px;
        transition: var(--transition);
        background: transparent;
    }

    .dropdown-item:hover {
        color: var(--primary-color) !important;
        background-color: var(--gold-light);
        padding-left: 25px;
    }

    .dropdown-item:active,
    .dropdown-item.active {
        background-color: var(--primary-color);
        color: #ffffff !important;
    }

    .btn:hover {
        transform: translateY(-3px);
        opacity: 0.95;
    }

    .footer-links a:hover {
        color: var(--accent-gold) !important;
        padding-left: 5px;
        transition: var(--transition);
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
